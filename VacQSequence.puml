@startuml WoTA_Sequence_Register
header WoTA Sequence Diagram
footer Page %page% of %lastpage%
title "Register (POST)"

actor "User / Admin" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<controllers>>\n:auth" as controllersAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as UsersDatabase

client->server ++:req.post('/api/v1/auth/register')
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth->controllersAuth ++:register()
deactivate routerAuth
deactivate server
controllersAuth->modelUser ++:create(req.body)
modelUser->modelUser :pre('save') hash password
modelUser->UsersDatabase ++:UserSchema
UsersDatabase-->modelUser --:user
controllersAuth<--modelUser --:user
controllersAuth->modelUser ++:getSignedJwtToken()
controllersAuth<--modelUser --:token
controllersAuth-->client --:response 201 {token}

@enduml

@startuml WoTA_Sequence_LoginLogout
header WoTA Sequence Diagram
footer Page %page% of %lastpage%
title "Login / Logout (FR2: authentication used before every use case)"

actor "User / Admin" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<controllers>>\n:auth" as controllersAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as UsersDatabase

group login: POST
client->server ++:req.post('/api/v1/auth/login')
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth->controllersAuth ++:login()
deactivate routerAuth
deactivate server
controllersAuth->modelUser ++:findOne({email}).select('+password')
modelUser->UsersDatabase ++:UserSchema
UsersDatabase-->modelUser --:user
controllersAuth<--modelUser --:user
controllersAuth->modelUser ++:matchPassword(password)
controllersAuth<--modelUser --:isMatch
alt user not found or password does not match
    controllersAuth-->client :response 401 (Invalid credentials)
else email and password match
    controllersAuth->modelUser ++:getSignedJwtToken()
    controllersAuth<--modelUser --:token
    controllersAuth-->client :response 200 {token} + token cookie
end
deactivate controllersAuth
end

group logout: GET
client->server ++:req.get('/api/v1/auth/logout')
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth->controllersAuth ++:logout()
deactivate routerAuth
deactivate server
controllersAuth-->client --:response 200 (token cookie cleared)
end

@enduml

