' WoTA - Sequence Diagrams, one per use case (1 use case = 1 sequence diagram), in the notation of the
' course "Manage Hospital (POST)" diagram. Calls are solid arrows, returns are dashed arrows.
' Extra credit checks (A4 availability, A6/A7 1-hour rule, A11 suspension) are left out, as the project allows.

@startuml WoTA_Sequence_Register
header WoTA Sequence Diagram
footer Page %page% of %lastpage%
title "Register (POST)"

actor "User / Admin" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<controllers>>\n:auth" as controllersAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as UsersDatabase

client->server ++:req.post('/api/v1/auth/register')
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth->controllersAuth ++:register()
deactivate routerAuth
deactivate server
controllersAuth->modelUser ++:create({name, tel, email, password, role})
modelUser->modelUser :pre('save') hash password
modelUser->UsersDatabase ++:UserSchema
UsersDatabase-->modelUser --:user
controllersAuth<--modelUser --:user
controllersAuth->modelUser ++:getSignedJwtToken()
controllersAuth<--modelUser --:token
controllersAuth-->client --:response 201 {token}

@enduml

@startuml WoTA_Sequence_LoginLogout
header WoTA Sequence Diagram
footer Page %page% of %lastpage%
title "Login / Logout (FR2: authentication used before every use case)"

actor "User / Admin" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<controllers>>\n:auth" as controllersAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as UsersDatabase

group login: POST
client->server ++:req.post('/api/v1/auth/login')
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth->controllersAuth ++:login()
deactivate routerAuth
deactivate server
controllersAuth->modelUser ++:findOne({email}).select('+password')
modelUser->UsersDatabase ++:UserSchema
UsersDatabase-->modelUser --:user
controllersAuth<--modelUser --:user
controllersAuth->modelUser ++:matchPassword(password)
controllersAuth<--modelUser --:isMatch
alt user not found or password does not match
    controllersAuth-->client :response 401 (Invalid credentials)
else email and password match
    controllersAuth->modelUser ++:getSignedJwtToken()
    controllersAuth<--modelUser --:token
    controllersAuth-->client :response 200 {token} + token cookie
end
deactivate controllersAuth
end

group logout: GET
client->server ++:req.get('/api/v1/auth/logout')
server->routerAuth ++:app.use('/api/v1/auth',auth)
routerAuth->controllersAuth ++:logout()
deactivate routerAuth
deactivate server
controllersAuth-->client --:response 200 (token cookie cleared)
end

@enduml

@startuml WoTA_Sequence_ViewCoworkingSpaces
header WoTA Sequence Diagram
footer Page %page% of %lastpage%
title "View Co-working Spaces (GET)"

actor "User" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:rooms" as routerRooms
participant "<<controllers>>\n:rooms" as controllersRooms
participant "<<model>>\n:Room" as modelRoom
database "<<MongoDB>>\n:rooms" as RoomsDatabase

group list co-working spaces: GET
client->server ++:req.get('/api/v1/rooms')
server->routerRooms ++:app.use('/api/v1/rooms',rooms)
routerRooms->controllersRooms ++:getRooms()
deactivate routerRooms
deactivate server
controllersRooms->modelRoom ++:find(filters).select().sort().skip().limit()
modelRoom->RoomsDatabase ++:RoomSchema
RoomsDatabase-->modelRoom --:rooms
controllersRooms<--modelRoom --:rooms
controllersRooms-->client --:response 200 {count, pagination, rooms}
end

group view one co-working space: GET
client->server ++:req.get('/api/v1/rooms/:id')
server->routerRooms ++:app.use('/api/v1/rooms',rooms)
routerRooms->controllersRooms ++:getRoom()
deactivate routerRooms
deactivate server
controllersRooms->modelRoom ++:findById(req.params.id)
modelRoom->RoomsDatabase ++:RoomSchema
RoomsDatabase-->modelRoom --:room
controllersRooms<--modelRoom --:room
controllersRooms-->client --:response 200 {room}
end

@enduml

@startuml WoTA_Sequence_ManageReservation
header WoTA Sequence Diagram
footer Page %page% of %lastpage%
title "Manage Reservation (POST / GET / PUT / DELETE)"

actor "User / Admin" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:rooms" as routerRooms
participant "<<router>>\n:reservations" as routerReservations
participant "<<middleware>>\n:auth" as middlewareAuth
participant "<<controllers>>\n:reservations" as controllersReservations
participant "<<model>>\n:Room" as modelRoom
participant "<<model>>\n:Reservation" as modelReservation
database "<<MongoDB>>\n:rooms" as RoomsDatabase
database "<<MongoDB>>\n:reservations" as ReservationsDatabase

group reserve a co-working space (FR3): POST
client->server ++:req.post('/api/v1/rooms/:roomId/reservations')
server->routerRooms ++:app.use('/api/v1/rooms',rooms)
routerRooms->routerReservations ++:router.use('/:roomId/reservations',reservationRouter)
deactivate routerRooms
deactivate server
routerReservations->middlewareAuth ++:protect(), authorize('admin','user')
middlewareAuth-->routerReservations --:req.user
routerReservations->controllersReservations ++:addReservation()
deactivate routerReservations
controllersReservations->modelRoom ++:findById(req.params.roomId)
modelRoom->RoomsDatabase ++:RoomSchema
RoomsDatabase-->modelRoom --:room
controllersReservations<--modelRoom --:room
controllersReservations->modelReservation ++:countDocuments({user, not ended yet})
modelReservation->ReservationsDatabase ++:ReservationSchema
ReservationsDatabase-->modelReservation --:count
controllersReservations<--modelReservation --:count
alt role is user and count >= 3
    controllersReservations-->client :response 400 (already made 3 reservations)
else
    controllersReservations->modelReservation ++:create({reservationDate, user: req.user.id, room})
    modelReservation->ReservationsDatabase ++:ReservationSchema
    ReservationsDatabase-->modelReservation --:reservation
    controllersReservations<--modelReservation --:reservation
    controllersReservations-->client :response 201 {reservation}
end
deactivate controllersReservations
end

newpage

group view reservations (FR4, FR7): GET
client->server ++:req.get('/api/v1/reservations')
server->routerReservations ++:app.use('/api/v1/reservations',reservations)
deactivate server
routerReservations->middlewareAuth ++:protect()
middlewareAuth-->routerReservations --:req.user
routerReservations->controllersReservations ++:getReservations()
deactivate routerReservations
controllersReservations->modelReservation ++:find(user: own id, or all for admin).populate('room')
modelReservation->ReservationsDatabase ++:ReservationSchema
ReservationsDatabase-->modelReservation --:reservations
controllersReservations<--modelReservation --:reservations
controllersReservations-->client --:response 200 {count, reservations}
end

newpage

group edit a reservation (FR5, FR8): PUT
client->server ++:req.put('/api/v1/reservations/:id')
server->routerReservations ++:app.use('/api/v1/reservations',reservations)
deactivate server
routerReservations->middlewareAuth ++:protect(), authorize('admin','user')
middlewareAuth-->routerReservations --:req.user
routerReservations->controllersReservations ++:updateReservation()
deactivate routerReservations
controllersReservations->modelReservation ++:findById(req.params.id)
modelReservation->ReservationsDatabase ++:ReservationSchema
ReservationsDatabase-->modelReservation --:reservation
controllersReservations<--modelReservation --:reservation
alt not the owner and not admin
    controllersReservations-->client :response 401 (not authorized)
else owner or admin
    controllersReservations->modelReservation ++:save({reservationDate, room})
    modelReservation->ReservationsDatabase ++:ReservationSchema
    ReservationsDatabase-->modelReservation --:reservation
    controllersReservations<--modelReservation --:reservation
    controllersReservations-->client :response 200 {reservation}
end
deactivate controllersReservations
end

newpage

group delete a reservation (FR6, FR9): DELETE
client->server ++:req.delete('/api/v1/reservations/:id')
server->routerReservations ++:app.use('/api/v1/reservations',reservations)
deactivate server
routerReservations->middlewareAuth ++:protect(), authorize('admin','user')
middlewareAuth-->routerReservations --:req.user
routerReservations->controllersReservations ++:deleteReservation()
deactivate routerReservations
controllersReservations->modelReservation ++:findById(req.params.id)
modelReservation->ReservationsDatabase ++:ReservationSchema
ReservationsDatabase-->modelReservation --:reservation
controllersReservations<--modelReservation --:reservation
alt not the owner and not admin
    controllersReservations-->client :response 401 (not authorized)
else owner or admin
    controllersReservations->modelReservation ++:deleteOne()
    modelReservation->ReservationsDatabase ++:ReservationSchema
    ReservationsDatabase-->modelReservation --:deleted
    controllersReservations<--modelReservation --:deleted
    controllersReservations-->client :response 200 {}
end
deactivate controllersReservations
end

@enduml

@startuml WoTA_Sequence_ManageCoworkingSpace
header WoTA Sequence Diagram
footer Page %page% of %lastpage%
title "Manage Co-working Space (POST / PUT / DELETE, admin only)"

actor "Admin" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:rooms" as routerRooms
participant "<<middleware>>\n:auth" as middlewareAuth
participant "<<controllers>>\n:rooms" as controllersRooms
participant "<<model>>\n:Room" as modelRoom
participant "<<model>>\n:Reservation" as modelReservation
database "<<MongoDB>>\n:rooms" as RoomsDatabase
database "<<MongoDB>>\n:reservations" as ReservationsDatabase

group add a co-working space: POST
client->server ++:req.post('/api/v1/rooms')
server->routerRooms ++:app.use('/api/v1/rooms',rooms)
deactivate server
routerRooms->middlewareAuth ++:protect(), authorize('admin')
middlewareAuth-->routerRooms --:req.user
routerRooms->controllersRooms ++:createRoom()
deactivate routerRooms
controllersRooms->modelRoom ++:create(req.body)
modelRoom->RoomsDatabase ++:RoomSchema
RoomsDatabase-->modelRoom --:room
controllersRooms<--modelRoom --:room
controllersRooms-->client --:response 201 {room}
end

newpage

group edit a co-working space: PUT
client->server ++:req.put('/api/v1/rooms/:id')
server->routerRooms ++:app.use('/api/v1/rooms',rooms)
deactivate server
routerRooms->middlewareAuth ++:protect(), authorize('admin')
middlewareAuth-->routerRooms --:req.user
routerRooms->controllersRooms ++:updateRoom()
deactivate routerRooms
controllersRooms->modelRoom ++:findByIdAndUpdate(req.params.id, req.body)
modelRoom->RoomsDatabase ++:RoomSchema
RoomsDatabase-->modelRoom --:room
controllersRooms<--modelRoom --:room
controllersRooms-->client --:response 200 {room}
end

newpage

group delete a co-working space (cascade delete): DELETE
client->server ++:req.delete('/api/v1/rooms/:id')
server->routerRooms ++:app.use('/api/v1/rooms',rooms)
deactivate server
routerRooms->middlewareAuth ++:protect(), authorize('admin')
middlewareAuth-->routerRooms --:req.user
routerRooms->controllersRooms ++:deleteRoom()
deactivate routerRooms
controllersRooms->modelRoom ++:findById(req.params.id)
modelRoom->RoomsDatabase ++:RoomSchema
RoomsDatabase-->modelRoom --:room
controllersRooms<--modelRoom --:room
controllersRooms->modelReservation ++:deleteMany({room: req.params.id})
modelReservation->ReservationsDatabase ++:ReservationSchema
ReservationsDatabase-->modelReservation --:deleted
controllersRooms<--modelReservation --:deleted
note right of controllersRooms
  also deletes the room's reviews and
  notes (extra credit data, A5 / A8)
end note
controllersRooms->modelRoom ++:deleteOne({_id: req.params.id})
modelRoom->RoomsDatabase ++:RoomSchema
RoomsDatabase-->modelRoom --:deleted
controllersRooms<--modelRoom --:deleted
controllersRooms-->client --:response 200 {}
end

@enduml
