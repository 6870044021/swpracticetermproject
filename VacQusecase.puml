@startuml WoTA_UseCase
' WoTA (Project #6 Co-working Space Reservation) - UML Use Case Diagram
' Adapted from the course VacQ use case diagram: Hospital -> Co-working Space, Appointment -> Reservation.
' Use cases are user goals, not steps: login/logout (FR2) is how a registered user authenticates
' before using them, and create/view/edit/delete are grouped as "Manage Reservation" (FR3-FR9).
' Extra credit requirements (A1-A13) are not drawn, as the term project instructions allow.
left to right direction
actor "User" as user
rectangle "WoTA: Co-working Space Reservation System" as WoTASystem {
    usecase "Register" as register
    usecase "View\nCo-working Spaces" as viewSpaces
    usecase "Manage\nReservation" as manageReservation
    usecase "Manage\nCo-working Space" as manageSpace
}

user -- register
user -- viewSpaces
user -- manageReservation

actor "Admin" as admin
register -- admin
viewSpaces -- admin
manageSpace -- admin
manageReservation -- admin

@enduml
