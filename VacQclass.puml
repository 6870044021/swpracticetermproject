@startuml WoTA_Class_UMLProfile
' WoTA - Class Diagram (UML Profile for REST API), same notation as the course VacQ diagram:
' <<Application>> --<<Path>>--> <<Resource>> (operations: <<HTTP verb>> +controllerMethod(): ReturnType)
' --<<use>>--> <<Representation>> (Mongoose model / MongoDB collection fields).
' This diagram covers FR1-FR9. The second diagram below shows the full API including extra credits.
left to right direction
hide circle
hide empty members
skinparam classAttributeIconSize 0
package "WoTA"{
    class "<<Application>>\nWoTAService" as WoTAService{}

    class "<<Resource>>\nRegister" as ResourceRegister{
        <<POST>> +register():User
    }

    class "<<Resource>>\nLogin" as ResourceLogin{
        <<POST>> +login():User
    }

    class "<<Resource>>\nLogout" as ResourceLogout{
        <<GET>> +logout():void
    }

    class "<<Resource>>\nMe" as ResourceMe{
        <<GET>> +getMe():User
    }

    class "<<Representation>>\nUser" as RepresentationUser{
        -name
        -tel
        -email
        -password
        -role
        -createdAt
    }

    class "<<Resource>>\nRooms" as ResourceRooms{
        <<GET>> +getRooms():Room
        <<POST>> +createRoom():Room
    }

    class "<<Resource>>\nRoom" as ResourceRoom{
        <<GET>> +getRoom():Room
        <<PUT>> +updateRoom():Room
        <<DELETE>> +deleteRoom():void
    }

    class "<<Representation>>\nRoom" as RepresentationRoom{
        -name
        -description
        -address
        -tel
        -openCloseTimes
    }

    class "<<Resource>>\nRoomReservations" as ResourceRoomReservations{
        <<GET>> +getReservations():Reservation
        <<POST>> +addReservation():Reservation
    }

    class "<<Resource>>\nReservations" as ResourceReservations{
        <<GET>> +getReservations():Reservation
    }

    class "<<Resource>>\nReservation" as ResourceReservation{
        <<GET>> +getReservation():Reservation
        <<PUT>> +updateReservation():Reservation
        <<DELETE>> +deleteReservation():void
    }

    class "<<Representation>>\nReservation" as RepresentationReservation{
        -reservationDate
        -user
        -room
        -createdAt
    }
}

WoTAService ..> ResourceRegister:"/auth/register\n<<Path>>"
WoTAService ..> ResourceLogin:"/auth/login\n<<Path>>"
WoTAService ..> ResourceLogout:"/auth/logout\n<<Path>>"
WoTAService ..> ResourceMe:"/auth/me\n<<Path>>"
ResourceRegister ..> RepresentationUser:"<<use>>"
ResourceLogin ..> RepresentationUser:"<<use>>"
ResourceMe ..> RepresentationUser:"<<use>>"

WoTAService ..> ResourceRooms:"/rooms\n<<Path>>"
ResourceRooms ..> ResourceRoom:"/{roomId}\n<<Path>>"
ResourceRoom ..> RepresentationRoom:"<<use>>"
ResourceRoom ..> ResourceRoomReservations:"/reservations\n<<Path>>"

WoTAService ..> ResourceReservations:"/reservations\n<<Path>>"
ResourceReservations ..> ResourceReservation:"/{reservationId}\n<<Path>>"
ResourceReservation ..> RepresentationReservation:"<<use>>"
ResourceRoomReservations ..> RepresentationReservation:"<<use>>"

@enduml

