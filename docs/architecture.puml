@startuml WoTA_Architecture
title WoTA subsystem model with implementation modules
left to right direction
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle
hide empty members
actor "Postman / API client" as client
package "HTTP boundary" {
  component "app.js\nExpress application" as app
  component "routes/auth.js\nroutes/rooms.js\nroutes/reservations.js\nroutes/reviews.js\nroutes/notes.js" as routes
  component "middleware/auth.js\nprotect / authorize / checkStatus" as auth
}
package "Application operations" {
  component "controllers/auth.js\ncontrollers/rooms.js\ncontrollers/reservations.js\ncontrollers/reviews.js\ncontrollers/notes.js" as controllers
  component "services/reservations.js" as reservations
  component "services/bookingTransaction.js" as transactions
  component "utils/booking.js\nutils/errors.js" as rules
}
package "Persistence" {
  class User <<Mongoose model>>
  class Room <<Mongoose model>>
  class Reservation <<Mongoose model>>
  class Review <<Mongoose model>>
  class Note <<Mongoose model>>
  class BookingLock <<Mongoose model>>
}
database "MongoDB replica set" as db
client --> app : HTTP JSON
app --> routes
routes --> auth
routes --> controllers
controllers --> reservations
controllers --> transactions
controllers --> rules
reservations --> transactions
reservations --> rules
controllers --> User
controllers --> Room
controllers --> Reservation
controllers --> Review
controllers --> Note
reservations --> User
reservations --> Room
reservations --> Reservation
transactions --> BookingLock
User --> db
Room --> db
Reservation --> db
Review --> db
Note --> db
BookingLock --> db
note bottom of controllers
  This is a layered request/response API with a central database.
  Modules are shown as components; persisted entities are models.
  It does not claim observer-based MVC, peer-to-peer or pipe/filter behavior.
end note
@enduml
